# Copy this file to .env and fill in your Supabase project credentials.
# Get them from: https://app.supabase.com -> Project Settings -> API
# .env is gitignored, so keep your real keys there (NOT here).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: override the table name (defaults to "contacts")
# VITE_SUPABASE_CONTACTS_TABLE=contacts
